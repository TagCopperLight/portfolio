:80 {
	root * /srv
	encode gzip zstd

	# Hashed build output: cache forever.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Font, favicon and screenshots keep their names: cache for a day.
	@static path /fonts/* /favicon.svg /projects/*.webp
	handle @static {
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Pages must revalidate. /projects/<slug>/ serves its index.html; anything else 404s.
	handle {
		header Cache-Control "no-cache"
		file_server
	}
}
